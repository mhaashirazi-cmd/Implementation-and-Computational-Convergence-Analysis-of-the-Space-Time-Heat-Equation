Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SetDirectory", "[", 
    RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rawData", "=", 
    RowBox[{"Import", "[", 
     RowBox[{"\"\<numerical_solution_final.txt\>\"", ",", "\"\<Table\>\""}], 
     "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"rawData", "===", "$Failed"}], ",", 
   RowBox[{"Print", "[", "\"\<Error loading data file!\>\"", "]"}], ",", 
   RowBox[{
    RowBox[{"cleanData", "=", 
     RowBox[{"Rest", "[", "rawData", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Filter", " ", "rows", " ", "where", " ", "y", " ", "is", " ", "approx", 
      " ", "0.5", " ", "AND", " ", "t", " ", "is", " ", "approx", " ", 
      "0.5"}], "*)"}], 
    RowBox[{"sliceData", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"cleanData", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", "0.5"}], "]"}], "<", 
           "0.03"}], "&&", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "-", "0.5"}], "]"}], "<", 
           "0.03"}]}], ")"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Sort", " ", "coordinates", " ", "by", " ", "x", " ", "value", " ", "to",
       " ", "ensure", " ", "a", " ", "clean", " ", "sequential", " ", "line", 
      " ", "plot"}], "*)"}], 
    RowBox[{"sortedSlice", "=", 
     RowBox[{"SortBy", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"row", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"row", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"row", ",", "sliceData"}], "}"}]}], "]"}], ",", "First"}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Generate", " ", "2", "D", " ", "Profile", " ", "Curve", " ", "Plot"}], 
     "*)"}], 
    RowBox[{"plot2DProfile", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"sortedSlice", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Red"}], "}"}]}], ",", 
       RowBox[{"PlotMarkers", "->", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", "6"}], "}"}]}], ",", 
       RowBox[{"GridLines", "->", "Automatic"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", 
          RowBox[{"Style", "[", "\"\<u(x, 0.5, 0.5)\>\"", "]"}], ",", "Bold", 
          ",", 
          RowBox[{"FontSize", "->", "16"}]}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "plot2DProfile", "]"}], ";"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9913035260007076`*^9, 3.9913035260007076`*^9}},
 CellLabel->
  "In[111]:=",ExpressionUUID->"e4ba5c39-ebac-4227-a4ec-1b7d05fb2223"],

