Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"rawData", "=!=", "$Failed"}], ",", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Function", " ", "to", " ", "grab", " ", "space", " ", "data", " ", "at",
       " ", "any", " ", "user"}], "-", 
     RowBox[{"defined", " ", "time", " ", "target"}]}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"getTimeSnapshot", "[", "targetT_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"filtered", ",", "structured"}], "}"}], ",", 
       RowBox[{
        RowBox[{"filtered", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"cleanData", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "-", "targetT"}], "]"}], "<", 
             "0.001"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"structured", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"row", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"row", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"row", "[", 
              RowBox[{"[", "4", "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"row", ",", "filtered"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ListPlot3D", "[", 
         RowBox[{"structured", ",", 
          RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}], ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1.1"}], "}"}]}], ",", 
          RowBox[{"Mesh", "->", "None"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<u\>\""}], 
            "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<Time t = \>\"", ",", "targetT"}], "}"}], "]"}]}], 
          ",", 
          RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Generate", " ", "frames", " ", "at", " ", "start"}], ",", 
      RowBox[{"quarter", "-", "cycle"}], ",", 
      RowBox[{
       RowBox[{"and", " ", "half"}], "-", "cycle"}]}], "*)"}], 
    RowBox[{"frame1", "=", 
     RowBox[{"getTimeSnapshot", "[", "0.0", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"frame2", "=", 
     RowBox[{"getTimeSnapshot", "[", "0.25", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"frame3", "=", 
     RowBox[{"getTimeSnapshot", "[", "0.5", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Combine", " ", "them", " ", "neatly", " ", "row"}], "-", "by", 
      "-", "row"}], "*)"}], 
    RowBox[{"Print", "[", 
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"frame1", ",", "frame2", ",", "frame3"}], "}"}], "}"}], ",", 
       RowBox[{"ImageSize", "->", "950"}]}], "]"}], "]"}], ";"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.99093361071222*^9, 3.99093361071222*^9}, 
   3.9909336588471413`*^9},
 CellLabel->"In[10]:=",ExpressionUUID->"29a28f32-8b0d-469d-b037-ac5c2d9856c4"],

