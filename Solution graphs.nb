Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Set", " ", "directory", " ", "and", " ", "import", " ", "data"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"SetDirectory", "[", 
     RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rawData", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"\"\<numerical_solution_final.txt\>\"", ",", "\"\<Table\>\""}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"rawData", "===", "$Failed"}], ",", 
     RowBox[{"Print", "[", "\"\<Error: File not found.\>\"", "]"}], ",", 
     RowBox[{
      RowBox[{"cleanData", "=", 
       RowBox[{"Rest", "[", "rawData", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Generate", " ", "3", "D", " ", "Surface", " ", "Plot"}], 
       "*)"}], 
      RowBox[{"plot3D", "=", 
       RowBox[{"ListPlot3D", "[", 
        RowBox[{"cleanData", ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Specularity", "[", 
            RowBox[{"White", ",", "30"}], "]"}], "]"}]}], ",", 
         RowBox[{"ColorFunction", "->", "\"\<Rainbow\>\""}], ",", 
         RowBox[{"Mesh", "->", "None"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<x\>\"", ",", "Bold", ",", 
              RowBox[{"FontSize", "->", "12"}]}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<t\>\"", ",", "Bold", ",", 
              RowBox[{"FontSize", "->", "12"}]}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<u(x,t)\>\"", ",", "Bold", ",", 
              RowBox[{"FontSize", "->", "12"}]}], "]"}]}], "}"}]}], ",", 
         RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "plot3D", "]"}]}]}], "]"}]}]}]], "Input",
