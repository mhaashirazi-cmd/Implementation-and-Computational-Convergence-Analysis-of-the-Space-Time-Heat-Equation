Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Force", " ", "directory", " ", "and", " ", "import", " ", 
    "your", " ", "row", " ", "string", " ", "data"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"SetDirectory", "[", 
     RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rawData", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"\"\<numerical_solution_final.txt\>\"", ",", "\"\<Table\>\""}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"rawData", "===", "$Failed"}], ",", 
     RowBox[{"Print", "[", "\"\<Error: Data file not found!\>\"", "]"}], ",", 
     RowBox[{
      RowBox[{"cleanData", "=", 
       RowBox[{"Rest", "[", "rawData", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"2.", " ", "Select", " ", "rows", " ", "matching", " ", "t"}],
         "=", 
        RowBox[{"0.5", " ", "precisely", " ", 
         RowBox[{"(", 
          RowBox[{
          "with", " ", "a", " ", "small", " ", "numerical", " ", 
           "tolerance"}], ")"}]}]}], "*)"}], 
      RowBox[{"tPlane05", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"cleanData", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "-", "0.5"}], "]"}], "<", 
           "0.001"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "3.", " ", "Structure", " ", "into", " ", "spatial", " ", "matrix", 
        " ", "coordinates", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "u"}], "}"}]}], "*)"}], 
      RowBox[{"plotData05", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"row", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"row", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{"row", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"row", ",", "tPlane05"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "4.", " ", "Render", " ", "3", "D", " ", "Spatial", " ", "Plane", " ", 
        "Graph"}], "*)"}], 
      RowBox[{"surfacePlot", "=", 
       RowBox[{"ListPlot3D", "[", 
        RowBox[{"plotData05", ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Specularity", "[", 
            RowBox[{"White", ",", "20"}], "]"}], "]"}]}], ",", 
         RowBox[{"ColorFunction", "->", "\"\<Rainbow\>\""}], ",", 
         RowBox[{"Mesh", "->", "None"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<x\>\"", ",", "Bold", ",", 
              RowBox[{"FontSize", "->", "16"}]}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<t\>\"", ",", "Bold", ",", 
              RowBox[{"FontSize", "->", "16"}]}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<u(x,y,t)\>\"", ",", "Bold", ",", 
              RowBox[{"FontSize", "->", "16"}]}], "]"}]}], "}"}]}], ",", 
         RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "surfacePlot", "]"}], ";"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9909335483479176`*^9, 3.9909335483599463`*^9}, {
