Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rawData", "=", 
    RowBox[{"Import", "[", 
     RowBox[{"\"\<numerical_solution_final.txt\>\"", ",", "\"\<Table\>\""}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"rawData", "===", "$Failed"}], ",", 
   RowBox[{"Print", "[", "\"\<Error loading data file!\>\"", "]"}], ",", 
   RowBox[{
    RowBox[{"cleanData", "=", 
     RowBox[{"Rest", "[", "rawData", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Filter", " ", "rows", " ", "where", " ", "y", " ", "is", " ", "approx", 
      " ", "0.5", " ", "AND", " ", "t", " ", "is", " ", "approx", " ", 
      "0.75"}], "*)"}], 
    RowBox[{"sliceData", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"cleanData", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", "0.5"}], "]"}], "<", 
           "0.03"}], "&&", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "-", "0.75"}], "]"}], "<", 
           "0.03"}]}], ")"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Sort", " ", "coordinates", " ", "by", " ", "x", " ", "value", " ", "to",
       " ", "ensure", " ", "a", " ", "clean", " ", "sequential", " ", "line", 
      " ", "plot"}], "*)"}], 
    RowBox[{"sortedSlice", "=", 
     RowBox[{"SortBy", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"row", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"row", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"row", ",", "sliceData"}], "}"}]}], "]"}], ",", "First"}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Generate", " ", "2", "D", " ", "Profile", " ", "Curve", " ", "Plot"}], 
     "*)"}], 
    RowBox[{"plot2DProfile", "=", 
