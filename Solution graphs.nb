Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "the", " ", "data", " ", "points", " ", "from", 
    " ", "your", " ", "table"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"cycles", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "7"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"exactValues", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"1.168201", ",", "8"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"numericalValues", "=", 
