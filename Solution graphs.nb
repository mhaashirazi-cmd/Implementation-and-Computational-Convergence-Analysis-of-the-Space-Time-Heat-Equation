Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Ensure", " ", "cleanData", " ", "exists", " ", "before", " ", "running", 
    " ", "this", " ", "block"}], "*)"}], 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"ValueQ", "[", "cleanData", "]"}], ",", 
    RowBox[{"(*", 
     RowBox[{
     "Construct", " ", "the", " ", "continuous", " ", "3", "D", " ", 
      "Interpolation", " ", 
      RowBox[{"mapping", ":", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "t"}], "}"}], ",", "u"}], "}"}]}]}], 
     "*)"}], 
    RowBox[{
     RowBox[{"spatialTemporalInterp", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"row", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"row", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"row", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"row", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"row", ",", "cleanData"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "Generate", " ", "2", "D", " ", "Profile", " ", "Slice", " ", "Plot", 
        " ", "at", " ", "y"}], "=", 
       RowBox[{
        RowBox[{"0.5", " ", "and", " ", "t"}], "=", "0.25"}]}], "*)"}], 
     RowBox[{"plot2D_t025", "=", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"spatialTemporalInterp", "[", 
         RowBox[{"x", ",", "0.5", ",", "0.25"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"GridLines", "->", "Automatic"}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Red", ",", "Thick"}], "}"}]}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<x\>\"", ",", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<u(x, 0.5, 0.25)\>\"", ",", "Bold", ",", 
             RowBox[{"FontSize", "->", "14"}]}], "]"}]}], "}"}]}], ",", 
        RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
