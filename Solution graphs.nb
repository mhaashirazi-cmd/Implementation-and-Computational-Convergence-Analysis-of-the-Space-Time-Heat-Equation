       "1.168419", ",", "1.168256", ",", "1.168215", ",", "1.168205"}], 
      "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Format", " ", "pairs", " ", "for", " ", "plotting"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"exactData", "=", 
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{"cycles", ",", "exactValues"}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"numericalData", "=", 
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{"cycles", ",", "numericalValues"}], "}"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
