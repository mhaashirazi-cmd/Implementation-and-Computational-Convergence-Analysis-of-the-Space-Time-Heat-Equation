Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Ensure", " ", "cleanData", " ", "exists", " ", "before", " ", "running", 
    " ", "this", " ", "block"}], "*)"}], 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"ValueQ", "[", "cleanData", "]"}], ",", 
    RowBox[{"(*", 
     RowBox[{
     "Construct", " ", "the", " ", "continuous", " ", "Interpolation", " ", 
      "mapping"}], "*)"}], 
    RowBox[{
     RowBox[{"spatialTemporalInterp", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"row", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"row", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"row", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"row", ",", "cleanData"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "Generate", " ", "2", "D", " ", "Profile", " ", "Slice", " ", "Plot", 
        " ", "at", " ", "t"}], "=", "0.5"}], "*)"}], 
     RowBox[{"plot2D", "=", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"spatialTemporalInterp", "[", 
         RowBox[{"x", ",", "0.5"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"GridLines", "->", "Automatic"}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Red", ",", "Thick"}], "}"}]}], ",", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<x\>\"", ",", "\"\<u(x, 0.5)\>\""}], "}"}]}], ",", 
        RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "plot2D", "]"}]}], ",", 
    RowBox[{
    "Print", "[", "\"\<Error: Data not loaded. Run Part 1 first.\>\"", 
     "]"}]}], "]"}]}]], "Input",
